alias sensor d0
alias ventCO2 d1
alias ventN d2
alias ventO2 d3
alias ventExhaust d4

alias noO2Prio r8
alias pressure r9
alias lowPressure r10
alias noN r11

define pressureMin 89
define pressureTarget 90
define pressureMax 91
define minRatioCO2 0.05
define minRatioN 0.05
define minPartialO2 22


loop:
yield

s ventO2 Mode Vent.Outward
s ventO2 PressureExternal pressureTarget
s ventCO2 Mode Vent.Outward
s ventCO2 PressureExternal pressureTarget
s ventExhaust Mode Vent.Inward
s ventExhaust PressureExternal pressureTarget
bdns ventN setupNoN
s ventN Mode Vent.Outward
s ventN PressureExternal pressureTarget
setupNoN:

l pressure sensor Pressure
slt lowPressure pressure pressureMin

bdns ventN noVentN
l r0 ventN PressureOutput # Should be pipe pressure
slt noN r0 10
j afterNoVentN
noVentN:
move noN 1
afterNoVentN:


l r0 sensor RatioOxygen
mul r0 r0 pressure
slt r0 r0 minPartialO2
and r1 lowPressure noN
or r2 r0 r1
s ventO2 On r2
seqz noO2Prio r0

l r0 sensor RatioCarbonDioxide
slt r0 r0 minRatioCO2
and r0 r0 noO2Prio
s ventCO2 On r0

bdns ventN skipN
l r0 sensor RatioNitrogen
slt r0 r0 minRatioN
or r0 r0 lowPressure
and r0 r0 noO2Prio
s ventN On r0
skipN:

sgt r0 pressure pressureMax
s ventExhaust On r0

j loop